# =============================================================================
# Martins3DVault - .gitignore
# =============================================================================

# 1. Dependências
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 2. Build & Compilação (Next.js, TypeScript, Bundlers)
/.next/
/out/
/build/
/dist/
*.tsbuildinfo
next-env.d.ts
.turbo
stitch_export/

# 3. Variáveis de Ambiente & Segredos (Preservar .env.example)
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example
*.pem
*.key
*.cert

# 4. Armazenamento de Dados, Caches 3D e Uploads
/data/
/data/*
!/data/.gitkeep

# 5. Pastas de Bibliotecas de Arquivos 3D do Usuário
/libraries/
/libraries/*
!/libraries/.gitkeep
!/libraries/sample_library

# 6. Bancos de Dados Locais e Dumps
*.sqlite
*.sqlite3
*.db
*.db-journal
postgres-data/

# 7. Logs e Depuração
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 8. Arquivos de Sistema Operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 9. Editores, IDEs e Ferramentas de IA
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.agents/
.gemini/
.cursor/
scratch/
tmp/
temp/
